/// Kích thước một khối (khoảng cách giữa hai trục đường), đơn vị ~ mét
pub const BLOCK: f32 = 80.0;
/// Độ rộng đường hai làn (khoảng 8 m, gần đúng với đường thật so với xe 4,2 m)
pub const ROAD: f32 = 20.0;
/// Số đường mỗi phía tính từ tâm
pub const GRID_N: i32 = 6;
/// Biên thành phố
pub const EXT: f32 = 480.0;
/// Giới hạn bản đồ cho phương tiện
pub const WORLD_LIMIT: f32 = 1900.0;
/// Máu mỗi tòa nhà
pub const BUILDING_HP: f32 = 150.0;
/// Sát thương trực tiếp khi đạn trúng tòa nhà
pub const DIRECT_DAMAGE: f32 = 80.0;
/// Bán kính ảnh hưởng của vụ nổ
pub const BLAST_RADIUS: f32 = 6.0;
/// Số xe NPC tối đa
pub const TRAFFIC_COUNT: usize = 16;
/// Khoảng cách vẽ tối đa
pub const DRAW_DIST: f32 = 1500.0;

/// Số ngẫu nhiên trong [lo, hi)
pub fn rnd(lo: f32, hi: f32) -> f32 {
    macroquad::rand::gen_range(lo, hi)
}