# house.obj - nhà mẫu viết tay, kích thước đơn vị 1 x 1 x 1 (x, z: -0.5..0.5; y: 0..1)
# Được scale theo kích thước khối trong layout.json
usemtl house
v -0.5 0.0 -0.5
v 0.5 0.0 -0.5
v 0.5 0.0 0.5
v -0.5 0.0 0.5
v -0.5 0.7 -0.5
v 0.5 0.7 -0.5
v 0.5 0.7 0.5
v -0.5 0.7 0.5
v 0.0 1.0 -0.5
v 0.0 1.0 0.5
f 4 3 7 8
f 1 5 6 2
f 1 4 8 5
f 2 6 7 3
f 5 8 10 9
f 6 9 10 7
f 8 7 10
f 5 9 6
